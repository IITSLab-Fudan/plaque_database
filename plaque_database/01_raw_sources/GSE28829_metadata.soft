^SERIES = GSE28829
!Series_title = Gene Expression in early and advanced atherosclerotic plaque from human carotid
!Series_geo_accession = GSE28829
!Series_status = Public on Apr 25 2011
!Series_submission_date = Apr 25 2011
!Series_last_update_date = Mar 25 2019
!Series_pubmed_id = 22388324
!Series_summary = The objective of this study is to identify genes and pathways involved in the progression of atherosclerotic plaques from early to advanced stage in humans.
!Series_overall_design = Samples from atherosclerotic carotid artery segments, from early ((pathological) intimal thickening and intimal xanthoma) and from advanced (thin or thick fibrous cap atheroma) lesions, have been retrieved from the Maastricht Pathology Tissue Collection (MPTC).
!Series_overall_design = Tissue was obtained during autopsy (Dept of Pathology, Maastricht University Medical Centre). Collection, storage  in the Maastricht Pathology Tissue Collection (MPTC) and use of tissue and patient data were performed in agreement with the "Code for Proper Secondary Use of Human Tissue"
!Series_type = Expression profiling by array
!Series_contributor = Marco,,Manca
!Series_contributor = Erik,,Biessen
!Series_contributor = Mat,,Daemen
