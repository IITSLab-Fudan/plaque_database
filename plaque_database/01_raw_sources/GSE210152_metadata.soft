^SAMPLE = GSM6422826
!Sample_title = Patient6 (P6)
!Sample_geo_accession = GSM6422826
!Sample_status = Public on May 22 2023
!Sample_submission_date = Jul 31 2022
!Sample_last_update_date = May 22 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = Carotid plaque
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = tissue: Carotid plaque
!Sample_characteristics_ch1 = sorting strategy: Live CD45+ cells
!Sample_characteristics_ch1 = subject status: patients undergoing carotid endarterectomy
!Sample_treatment_protocol_ch1 = Carotid plaques were extracted from patients undergoing carotid endarterectomy (CEA).Patients were defined as symptomatic if they experienced symptoms (stroke, transitory ischemic attack, or amaurosis fugax) with a carotid plaque with a degree of stenosis greater than 70%. Asymptomatic carotid plaques were associated with no documented clinical symptoms but had indication for CEA due to a high degree of stenosis, according to NASCET (North American Symptomatic Carotid Endarterectomy Trial) or ESCT (European Carotid Surgery Trial) criteria
!Sample_molecule_ch1 = polyA RNA
!Sample_extract_protocol_ch1 = Carotid tissue was extensively washed in RPMI, finely minced and tissue fragments were incubated in collagenase type I, elastase type III , and DNase, with trypsin inhibitor, polymixin B , andCaCl2, in RPMI medium 1640 with 5% FBS in a shaker at 37°C for 45 min. Cell suspension was filtered through an 80-μm Nylon mesh and washed in media. Collected cells were incubated with live/dead stain at 1:1,000 in PBS for 10 min at 4 °C.
!Sample_extract_protocol_ch1 = Cells were then washed with FACS buffer (PBS with 2% FBS), stained for CD45 antibody for 30 min at RT then washed twice with FACS buffer, resuspended in a final FACS buffer volume of 500 μl, filtered through an Easy Strain 100-μm cell strainer and sorted for live CD45+ cells using FACS ARIAIII in FBS.
!Sample_data_processing = 1. Alignment. Sequence reads were mapped using 10x Genomics CellRanger multi pipeline (version cellranger-6.0.0) with the 10x human reference transcriptome (version 2020-A).
!Sample_data_processing = 2. Background noise removal. The CellBender ‘remove-background’ tool was applied to the raw CellRanger count matrices to eliminate technical artifacts (including ambient RNA).
!Sample_data_processing = Supplementary files format and content: raw.h5ad: anndata object with gene expression (GEX) counts from CellBender (filtered output) in the ".X" slot .
!Sample_platform_id = GPL20301
