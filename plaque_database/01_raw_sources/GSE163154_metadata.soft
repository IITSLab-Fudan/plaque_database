^SAMPLE = GSM4973394
!Sample_title = non-IPH 1
!Sample_geo_accession = GSM4973394
!Sample_status = Public on Dec 15 2020
!Sample_submission_date = Dec 14 2020
!Sample_last_update_date = Dec 15 2020
!Sample_type = RNA
!Sample_channel_count = 1
!Sample_source_name_ch1 = carotid plaque
!Sample_organism_ch1 = Homo sapiens
!Sample_taxid_ch1 = 9606
!Sample_characteristics_ch1 = classification: non-IPH
!Sample_treatment_protocol_ch1 = The endarterectomy specimens were cut into parallel, transverse segments of 5 mm thickness. Each alternating segment was snap frozen in liquid nitrogen and stored at -80 degrees C, their flanking segments fixed in formalin and processed for histological evaluation. Hematoxylin-Eosin (H.E) stained slides from these flanking segments have their plaques staged using the Virmani classification criteria by a cardiovascular pathologist (MD) and two experienced researchers in cardiovascular pathology (VH, JS). Segments designated as IPH or non-IPH based on the presence/absence of intraplaque haemorrhage.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = RNA of the 24 sample pairs was isolated using Guanidium Thiocyanate lysis followed by Cesium Chloride gradient centrifugation. After the extracting procedure, the RNA was further purified using the Nucleospin RNAII kit (Macherey-Nagel GmbH & Co. KG). RNA concentration was measured using a Nanodrop ND-1000 spectrophotometer (Nanodrop Technologies, Wilmington, DE, U.S.A). The RNA quality and integrity was determined using Lab-on-Chip analysis on an Agilent 2100 Bioanalyzer (Agilent Technologies, Inc., Santa Clara, CA, U.S.A.). Samples that had an RNA Integrity Number (RIN) lower than 5.6 were excluded from the study. In total 43 samples (16 paired) from 24 patients were eligible for submission to the transcriptomics platform.
!Sample_label_ch1 = biotin
!Sample_label_protocol_ch1 = The RNA labeling, hybridisation and data extraction were performed at ServiceXS (Leiden, The Netherlands). Biotinylated cRNA was prepared using the Illumina TotalPrep RNA Amplification Kit (Ambion, Inc., Austin, TX, U.S.A.) according to the manufacturer's specifications starting with 100 ng total RNA. Per sample 750 ng of cRNA was used for hybridization.
!Sample_hyb_protocol = Hybridization and washing were performed according to the Illumina standard assay procedure.
!Sample_scan_protocol = Scanning was performed on the Illumina BeadStation 500 (Illumina, Inc., San Diego, CA, U.S.A.).
!Sample_description = plaque without intraplaque haemorrhage
!Sample_description = SAMPLE 1
!Sample_data_processing = Image analysis and extraction of raw expression data was performed with Illumina Beadstudio v3 Gene Expression software with default settings (no background substraction) and no normalization. Transcriptomic data were analysed using the R Bioconductor lumi package (v2.38.0).
!Sample_platform_id = GPL6104
!Sample_contact_name = Han,,Jin
!Sample_contact_institute = Maastricht University
!Sample_contact_address = P. Debyelaan 25
!Sample_contact_city = Maastricht
!Sample_contact_zip/postal_code = 6229 HX
!Sample_contact_country = Netherlands
!Sample_supplementary_file = NONE
!Sample_series_id = GSE163154
!Sample_data_row_count = 22184
